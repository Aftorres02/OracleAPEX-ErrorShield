page 200 (
    name: Application Preferences
    alias: ERROR-SHIELD-PREFERENCES
    title: Application Preferences
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            tableName: LOGGER_PREFS
            includeRowidColumn: true
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 210
                items: {
                    P210_ROWID: \#ROWID#\
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 382141059926074934
        }

        column PREF_NAME (
            type: plainText
            heading {
                heading: Pref Name
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PREF_TYPE (
            type: plainText
            heading {
                heading: Pref Type
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            enableUsersTo {
                filter: true
            }
            advanced {
                endUserAlias: D
            }
        )

        column PREF_VALUE (
            type: plainText
            heading {
                heading: Pref Value
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ROWID (
            type: hidden
            heading {
                heading: ROWID
            }
            layout {
                sequence: 0
            }
            source {
                dataType: OTHER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report 1
        }

        savedReport 3821449 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PREF_NAME (
                sequence: 2
            )

            displayColumn PREF_TYPE (
                sequence: 4
            )

            displayColumn PREF_VALUE (
                sequence: 3
            )

            displayColumn ROWID (
                sequence: 1
            )

            controlBreak (
                column: PREF_TYPE
                layout {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 210
                clearCache: 210
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

