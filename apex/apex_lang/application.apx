app ERROR-SHIELD (
    name: Error Shield
    group: @capworks
    logo {
        type: text
        text: Error Shield
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/top-navigation-menu
        templateOptions: #DEFAULT#
        listPosition: top
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    css {
        fileUrls: #APP_FILES#app-icon.css?version=#APP_VERSION#
    }
    authentication {
        scheme: @application-express-accounts
    }
    security {
        runtimeApiUsage: modifyThisApp
    }
    sessionStateProtection {
        checksumSalt: 440E012DBECC62720B78F9121E12379314EE6D7B50B595D3B6101B5165649410
    }
    sessionManagement {
        sessionStateCommits: immediate
    }
    globalization {
        documentDirection: leftToRight
    }
    rowSearch {
        tokenize: false
    }
    reportPrinting {
        type: useInstanceSettings
    }
    errorHandling {
        defaultDisplayLocation: inlineWithFieldAndInNotification
        errorHandlingFunctionName: ersh_error_handler_api.apex_error_handling
    }
    runtime {
        allowFeedback: true
        accessibleReadOnlyItems: false
    }
    advanced {
        passEcid: false
        appBuilderIconName: app-icon.svg
    }

    substitution APP_NAME (
        value {
            staticValue: Error Shield
        }
    )

)

