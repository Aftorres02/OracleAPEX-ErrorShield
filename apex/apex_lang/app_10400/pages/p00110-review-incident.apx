page 110 (
    name: Review Incident
    alias: REVIEW-INCIDENT
    title: Review Incident
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region audit (
        name: Audit
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @review-incident
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region dialog (
        name: Dialog
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region review-incident (
        name: Review Incident
        type: form
        source {
            location: localDatabase
            tableName: ERSH_SHIELD_INCIDENTS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P110_ACTIVE_YN (
        type: displayOnly
        label {
            label: Active Yn
            alignment: left
        }
        layout {
            sequence: 10
            region: @audit
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
