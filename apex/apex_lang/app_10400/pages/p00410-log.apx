            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @log
            column: SID
            dataType: number
        }
    )

    pageItem P410_TEXT (
        type: textarea
