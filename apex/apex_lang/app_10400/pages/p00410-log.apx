        layout {
            sequence: 30
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @log
            column: TEXT
            dataType: varchar2
        }
