    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @log
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 400
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @log
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P410_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @log
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P410_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @log
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P410_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    button view-incident (
        buttonName: VIEW_INCIDENT
        label: View Incident
        layout {
            sequence: 10
            region: @incident-occurrences
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 110
                items: {
                    P110_SHIELD_INCIDENT_ID: &P410_SHIELD_INCIDENT_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: VIEW_INCIDENT
        }
    )

    validation p410-time-stamp-must-be-timestamp (
        name: P410_TIME_STAMP must be timestamp
        execution {
            sequence: 30
        }
        validation {
            type: itemIsAValidTimestamp
            item: P410_TIME_STAMP
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P410_TIME_STAMP
        }
    )

    process initialize-form-log (
        name: Initialize form Log
        type: formInitialization
        formRegion: @log
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 382481499053296414
        }
    )

    process load-shield-incident-id (
        name: Load Shield Incident Id
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- ERSH-051: a log that is a reference code shown to a user has
                -- exactly one ersh_incident_occurrences row (unique on
                -- logger_log_id). Resolve its incident so the Incident
                -- Occurrences region and the View Incident button can list every
                -- hit of that incident. max() returns null instead of raising
                -- no_data_found for any other log, which hides both.
                select max(o.shield_incident_id)
                  into :P410_SHIELD_INCIDENT_ID
                  from ersh_incident_occurrences_vw o
                 where o.logger_log_id = :P410_ID;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 24891257302270957
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P410_ID
        }
    )

    process process-form-log (
        name: Process form Log
        type: formAutoRowProcessing
        formRegion: @log
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 382481893555296414
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 400
            }
        }
    )

)

