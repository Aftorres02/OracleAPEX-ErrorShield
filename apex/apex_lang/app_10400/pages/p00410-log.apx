page 410 (
    name: Log
    alias: LOG
    title: Log
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region log (
        name: Log
        type: form
        source {
            location: localDatabase
            tableName: LOGGER_LOGS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        readOnly {
            type: always
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P410_ACTION (
        type: textarea
        label {
            label: Action
            alignment: right
        }
        layout {
            sequence: 70
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @log
            column: ACTION
            dataType: varchar2
        }
    )

    pageItem P410_CALL_STACK (
        type: textarea
        label {
            label: Call Stack
            alignment: right
        }
        layout {
            sequence: 100
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @log
            column: CALL_STACK
            dataType: varchar2
        }
    )

    pageItem P410_CLIENT_IDENTIFIER (
        type: textarea
        label {
            label: Client Identifier
            alignment: right
        }
        layout {
            sequence: 90
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @log
            column: CLIENT_IDENTIFIER
            dataType: varchar2
        }
    )

    pageItem P410_CLIENT_INFO (
        type: textField
        label {
            label: Client Info
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 160
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 64
        }
        source {
            formRegion: @log
            column: CLIENT_INFO
            dataType: varchar2
        }
    )

    pageItem P410_EXTRA (
        type: textarea
        label {
            label: Extra
            alignment: right
        }
        layout {
            sequence: 140
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @log
            column: EXTRA
            dataType: clob
        }
    )

    pageItem P410_ID (
        type: hidden
        layout {
            sequence: 10
            region: @log
            slot: regionBody
        }
        source {
            formRegion: @log
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P410_LINE_NO (
        type: textarea
        label {
            label: Line No
            alignment: right
        }
        layout {
            sequence: 120
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @log
            column: LINE_NO
            dataType: varchar2
        }
    )

    pageItem P410_LOGGER_LEVEL (
        type: numberField
        label {
            label: Logger Level
            alignment: right
        }
        layout {
            sequence: 20
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @log
            column: LOGGER_LEVEL
            dataType: number
        }
    )

    pageItem P410_MODULE (
        type: textarea
        label {
            label: Module
            alignment: right
        }
        layout {
            sequence: 60
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @log
            column: MODULE
            dataType: varchar2
        }
    )

    pageItem P410_SCN (
        type: numberField
        label {
            label: Scn
            alignment: right
        }
        layout {
            sequence: 130
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @log
            column: SCN
            dataType: number
        }
    )

    pageItem P410_SCOPE (
        type: textarea
        label {
            label: Scope
            alignment: right
        }
        layout {
            sequence: 50
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @log
            column: SCOPE
            dataType: varchar2
        }
    )

    pageItem P410_SID (
        type: numberField
        label {
            label: Sid
            alignment: right
        }
        layout {
            sequence: 150
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @log
            column: SID
            dataType: number
        }
    )

    pageItem P410_TEXT (
        type: textarea
        label {
            label: Text
            alignment: right
        }
        layout {
            sequence: 30
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @log
            column: TEXT
            dataType: varchar2
        }
    )

    pageItem P410_TIME_STAMP (
        type: datePicker
        label {
            label: Time Stamp
            alignment: right
        }
        layout {
            sequence: 40
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @log
            column: TIME_STAMP
            dataType: timestamp
        }
    )

    pageItem P410_UNIT_NAME (
        type: textarea
        label {
            label: Unit Name
            alignment: right
        }
        layout {
            sequence: 110
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @log
            column: UNIT_NAME
            dataType: varchar2
        }
    )

    pageItem P410_USER_NAME (
        type: textarea
        label {
            label: User Name
            alignment: right
        }
        layout {
            sequence: 80
            region: @log
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @log
            column: USER_NAME
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @log
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 400
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @log
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P410_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @log
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P410_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @log
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P410_ID
        }
        config {
            buildOption: @commented-out
        }
    )

    validation p410-time-stamp-must-be-timestamp (
        name: P410_TIME_STAMP must be timestamp
        execution {
            sequence: 30
        }
        validation {
            type: itemIsAValidTimestamp
            item: P410_TIME_STAMP
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P410_TIME_STAMP
        }
    )

    process initialize-form-log (
        name: Initialize form Log
        type: formInitialization
        formRegion: @log
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 382481499053296414
        }
    )

    process process-form-log (
        name: Process form Log
        type: formAutoRowProcessing
        formRegion: @log
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 382481893555296414
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 400
            }
        }
    )

)

