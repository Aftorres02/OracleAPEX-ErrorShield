page 1400 (
    name: "Running now "
    alias: RUNNING-NOW
    title: "Running now "
    pageGroup: @jobs
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region running-now (
        name: "Running now "
        type: classicReport
        source {
            location: localDatabase
            tableName: ERSH_JOBS_RUNNING_VW
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No jobs are currently running.
        }

        column CPU_SECS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Cpu Secs
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column ELAPSED_SECS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Elapsed Secs
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column JOB_ACTION_HEAD (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Job Action Head
                alignment: center
            }
            layout {
                sequence: 140
            }
            sorting {
                sortable: false
            }
        )

        column JOB_CLASS (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Job Class
                alignment: center
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

        column JOB_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Job Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 1200
                    items: {
                        P1200_OWNER: #OWNER#
                        P1200_JOB_NAME: #JOB_NAME#
                    }
                }
                linkText: #JOB_NAME#
            }
            sorting {
                sortable: false
            }
        )

        column JOB_SUBNAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Job Subname
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column JOB_TYPE (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Job Type
                alignment: center
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )

        column MAX_RUN_DURATION (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Max Run Duration
                alignment: center
            }
            layout {
                sequence: 120
            }
            sorting {
                sortable: false
            }
        )

        column OVER_MAX_DURATION_YN (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Over Max Duration Yn
                alignment: center
            }
            layout {
                sequence: 130
            }
            sorting {
                sortable: false
            }
        )

        column OWNER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Owner
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column RESOURCE_CONSUMER_GROUP (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Resource Consumer Group
                alignment: center
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column SESSION_ID (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Session Id
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column SLAVE_PROCESS_ID (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Slave Process Id
                alignment: center
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column STATE (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: State
                alignment: center
            }
            layout {
                sequence: 110
            }
            sorting {
                sortable: false
            }
        )

    )

)

