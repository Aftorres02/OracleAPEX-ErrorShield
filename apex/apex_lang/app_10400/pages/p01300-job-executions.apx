page 1300 (
    name: Job-Executions
    alias: JOB-EXECUTIONS
    title: Job-Executions
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region job-executions (
        name: Job-Executions
        type: interactiveReport
        source {
            location: localDatabase
            tableName: ERSH_JOB_EXECUTIONS_VW
            whereClause:
                ```sql
                log_date >= systimestamp - numtodsinterval(nvl(:P1030_DAYS, 7), 'day')
                  and (:P1030_STATUS   is null or status   = :P1030_STATUS)
                  and (:P1030_JOB_NAME is null or job_name = :P1030_JOB_NAME)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 423004790235911412
        }

        column ACTUAL_START_DATE (
            type: plainText
            heading {
                heading: Actual Start Date
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
