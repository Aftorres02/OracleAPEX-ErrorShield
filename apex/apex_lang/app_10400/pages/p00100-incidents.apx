page 100 (
    name: Incidents
    alias: INCIDENTS
    title: Incidents
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region summary (
        name: Summary
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_status as (
                  select count(case when incident_status = 'OPEN' then 1 end)       as open_cnt
                       , count(case when incident_status = 'REGRESSION' then 1 end) as regression_cnt
                    from ersh_shield_incidents_vw
                ), w_recent as (
                  select count(1)                 as hits_24h
                       , count(distinct app_user)  as users_24h
                    from ersh_incident_occurrences
                   where active_yn = 'Y'
                     and occurred_on > systimestamp - 1
                )
                select s.open_cnt        as open
                     , s.regression_cnt  as regressions
                     , r.hits_24h        as hits_24h
                     , r.users_24h       as users_24h
                  from w_status  s
                  cross join w_recent r
                ```
        }
        layout {
            sequence: 3
            slot: body
            columnSpan: "8"
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: summaryCR
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                u-colors
                t-BadgeList--medium
                t-BadgeList--dash
                t-BadgeList--fixed
                t-Report--hideNoPagination
            ]
        }

        column OPEN (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Open
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column REGRESSIONS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Regressions
                alignment: center
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if REGRESSIONS>0/}<span class="t-Badge ersh-badge ersh-badge--regression">#REGRESSIONS#</span>{%else/}#REGRESSIONS#{endif/}
                    ```
            }
        )

        column HITS_24H (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Hits 24h
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column USERS_24H (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Users 24h
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

    )

