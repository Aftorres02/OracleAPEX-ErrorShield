    pageItem P100_FOUND_INCIDENT_ID (
        type: hidden
        layout {
            sequence: 20
            region: @find-incident
            slot: regionBody
        }
    )

    pageItem P100_SEARCH_CODE (
        type: textField
        label {
            label: Reference Code
            alignment: left
        }
        layout {
            sequence: 10
            region: @find-incident
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            valuePlaceholder: e.g. 0000005003
        }
        validation {
            maxLength: 20
        }
    )

    button find-incident (
        buttonName: FIND_INCIDENT
        label: Find Incident
        layout {
            sequence: 20
            region: @find-incident
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
    )

    process find-incident (
        name: Find Incident
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_code           varchar2(4000);
                  l_logger_log_id  number;
                begin
                  :P100_FOUND_INCIDENT_ID := null;
                  l_code := trim(:P100_SEARCH_CODE);
                
                  begin
                    l_logger_log_id := to_number(l_code);
                  exception
                    when others then
                      l_logger_log_id := null;
                  end;
                
                  if l_logger_log_id is null then
                    apex_error.add_error(
                        p_message          => 'Enter a valid reference code (digits only).'
                      , p_display_location => apex_error.c_inline_with_field_and_notif
                      , p_page_item_name   => 'P100_SEARCH_CODE'
                    );
                    return;
                  end if;
                
                  begin
                    select shield_incident_id
                      into :P100_FOUND_INCIDENT_ID
                      from ersh_incident_occurrences_vw
                     where logger_log_id = l_logger_log_id;
                  exception
                    when no_data_found then
                      apex_error.add_error(
                          p_message          => 'No incident found for reference code ' || l_code || '.'
                        , p_display_location => apex_error.c_inline_with_field_and_notif
                        , p_page_item_name   => 'P100_SEARCH_CODE'
                      );
                  end;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 17641373874968060
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: FIND_INCIDENT
        }
    )

    branch (
        name: Go to Found Incident
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 110
                items: {
                    P110_SHIELD_INCIDENT_ID: &P100_FOUND_INCIDENT_ID.
                }
            }
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P100_FOUND_INCIDENT_ID
        }
    )

)

