            displayColumn REFERENCE_DISPLAY (
                sequence: 8
            )

            displayColumn RESOLUTION_NOTES (
                sequence: 13
            )

            displayColumn RESOLVED_BY (
                sequence: 11
            )

            displayColumn RESOLVED_ON (
                sequence: 12
            )

            displayColumn RESOLVED_YN (
