page 1000 (
    name: Jobs - Dashboard
    alias: JOBS-DASHBOARD
    title: Jobs - dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region health-by-source (
        name: Health by source
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_jobs as (
                  select case
                           when j.job_name like 'DBMS\_JOB$\_%' escape '\' then 'DBMS_JOB legacy'
                           else 'SCHEDULER'
                         end                                                       as job_source
                       , j.state                                                   as state
                       , j.enabled                                                 as enabled
                    from all_scheduler_jobs j
                )
                select w.job_source                                                as job_source
                     , count(*)                                                    as total_cnt
                     , count(case when w.state in ('BROKEN', 'FAILED') then 1 end) as problem_cnt
                     , count(case when w.state = 'RUNNING'             then 1 end) as running_cnt
                     , count(case when w.enabled = 'FALSE'             then 1 end) as disabled_cnt
                  from w_jobs w
                 group by w.job_source
                 order by w.job_source
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DISABLED_CNT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Disabled Cnt
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column JOB_SOURCE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Job Source
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column PROBLEM_CNT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Problem Cnt
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column RUNNING_CNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Running Cnt
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column TOTAL_CNT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Total Cnt
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    region next-runs-60-min (
        name: Next runs · 60 min
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.owner                                                     as owner
                     , j.job_name                                                  as job_name
                     , to_char(j.next_run_date, 'HH24:MI')                         as next_run_at
                     , j.schedule_type                                             as schedule_type
                     , j.repeat_interval                                           as repeat_interval
                  from all_scheduler_jobs j
                 where j.enabled       = 'TRUE'
                   and j.next_run_date is not null
                   and j.next_run_date <= systimestamp + interval '60' minute
                 order by j.next_run_date
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }

        column JOB_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Job Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column NEXT_RUN_AT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Next Run At
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column OWNER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Owner
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column REPEAT_INTERVAL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Repeat Interval
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column SCHEDULE_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Schedule Type
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

    region recent-failures-72-h (
        name: Recent failures · 72 h
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.log_id                                                    as log_id
                     , d.owner                                                     as owner
                     , d.job_name                                                  as job_name
                     , d.status                                                     as status
                     , d.error#                                                    as error_code
                     , to_char(d.actual_start_date, 'YYYY-MM-DD HH24:MI')          as started_at
                     , round(
                         extract(day    from d.run_duration) * 86400
                       + extract(hour   from d.run_duration) * 3600
                       + extract(minute from d.run_duration) * 60
                       + extract(second from d.run_duration)
                       , 1)                                                        as run_secs
                     , substr(d.additional_info, 1, 200)                           as additional_info
                  from all_scheduler_job_run_details d
                 where d.log_date >= systimestamp - interval '3' day
                   and nvl(d.status, 'UNKNOWN') <> 'SUCCEEDED'
                 order by d.log_date desc
                 fetch first 20 rows only
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ADDITIONAL_INFO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Additional Info
                alignment: center
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column ERROR_CODE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Error Code
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column JOB_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Job Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column LOG_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Log Id
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column OWNER (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Owner
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column RUN_SECS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Run Secs
                alignment: center
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column STARTED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Started At
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column STATUS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

    region status (
        name: Status
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_jobs as (
                  select count(*)                                                    as visible_cnt
                       , count(case when j.enabled = 'TRUE'              then 1 end) as enabled_cnt
                       , count(case when j.state in ('BROKEN', 'FAILED') then 1 end) as broken_cnt
                    from all_scheduler_jobs j
                )
                , w_running as (
                  select count(*)                                                    as running_cnt
                    from all_scheduler_running_jobs r
                )
                , w_failed as (
                  select count(*)                                                    as failed_cnt
                    from all_scheduler_job_run_details d
                   where d.log_date >= systimestamp - interval '1' day
                     and nvl(d.status, 'UNKNOWN') <> 'SUCCEEDED'
                )
                select j.visible_cnt                                                 as visible_jobs
                     , j.enabled_cnt                                                 as enabled
                     , j.broken_cnt                                                  as broken_or_failed
                     , r.running_cnt                                                 as running_now
                     , f.failed_cnt                                                  as failed_runs_24h
                  from w_jobs      j
                 cross join w_running r
                 cross join w_failed  f
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                u-colors
                t-BadgeList--medium
                t-BadgeList--dash
                t-BadgeList--fixed
                t-Report--hideNoPagination
            ]
        }

        column BROKEN_OR_FAILED (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Broken Or Failed
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column ENABLED (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Enabled
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column FAILED_RUNS_24H (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Failed Runs 24h
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

        column RUNNING_NOW (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Running Now
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column VISIBLE_JOBS (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Visible Jobs
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

    )

)

