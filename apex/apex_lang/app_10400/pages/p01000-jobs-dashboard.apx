page 1000 (
    name: Jobs - Dashboard
    alias: JOBS-DASHBOARD
    title: Jobs - dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region health-by-source (
        name: Health by source
        type: classicReport
        source {
            location: localDatabase
            tableName: ERSH_JOBS_HEALTH_BY_SOURCE_VW
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DISABLED_CNT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Disabled Cnt
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column JOB_SOURCE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Job Source
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column PROBLEM_CNT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Problem Cnt
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column RUNNING_CNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Running Cnt
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column TOTAL_CNT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Total Cnt
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    region next-runs-60-min (
        name: Next runs · 60 min
        type: classicReport
        source {
            location: localDatabase
            tableName: ERSH_JOBS_NEXT_RUNS_VW
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSelectList
        }

        column JOB_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Job Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column NEXT_RUN_AT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Next Run At
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column OWNER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Owner
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column REPEAT_INTERVAL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Repeat Interval
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column SCHEDULE_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Schedule Type
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

    region recent-failures-72-h (
        name: Recent failures · 72 h
        type: classicReport
        source {
            location: localDatabase
            tableName: ERSH_JOBS_RECENT_FAILURES_VW
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column ADDITIONAL_INFO (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Additional Info
                alignment: center
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column ERROR_CODE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Error Code
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column JOB_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Job Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column LOG_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Log Id
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column OWNER (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Owner
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column RUN_SECS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Run Secs
                alignment: center
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column STARTED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Started At
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column STATUS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

    region status (
        name: Status
        type: classicReport
        source {
            location: localDatabase
            tableName: ERSH_JOBS_STATUS_VW
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/badge-list
            templateOptions: [
                #DEFAULT#
                u-colors
                t-BadgeList--medium
                t-BadgeList--dash
                t-BadgeList--fixed
                t-Report--hideNoPagination
            ]
        }

        column BROKEN_OR_FAILED (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Broken Or Failed
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column ENABLED (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Enabled
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column FAILED_RUNS_24H (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Failed Runs 24h
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

        column RUNNING_NOW (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Running Now
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column VISIBLE_JOBS (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Visible Jobs
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

    )

    button start-live-demo (
        buttonName: START_LIVE_DEMO
        label: Start live demo
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-play
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: START_LIVE_DEMO
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1                                                   as demo_available
                  from user_objects o
                 where o.object_name = 'ERSH_DEMO_DATA_API'
                   and o.object_type = 'PACKAGE BODY'
                   and o.status      = 'VALID'
                   and not exists (
                         select 1
                           from user_scheduler_jobs j
                          where j.job_name like 'ERSH\_DEMO\_LIVE\_%' escape '\'
                            and j.enabled  = 'TRUE'
                       )
                ```
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    button stop-live-demo (
        buttonName: STOP_LIVE_DEMO
        label: Stop live demo
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-stop
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: STOP_LIVE_DEMO
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1                                                   as demo_running
                  from user_scheduler_jobs j
                 where j.job_name like 'ERSH\_DEMO\_LIVE\_%' escape '\'
                ```
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    process start-live-demo (
        name: Start live jobs demo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- ersh_demo_data_api is demo-only (demos/, never installed by the
                -- release), so this app must not depend on it at compile time. The
                -- button that submits this request only renders when it exists.
                execute immediate 'begin ersh_demo_data_api.start_live_jobs_demo; end;';
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Live jobs demo started. Six demo jobs now run every 20 to 30 seconds for the next hour, and some of them fail on purpose.
        }
        advanced {
            executionMappingIdentifier: 52462276030934053
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'START_LIVE_DEMO'
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    process stop-live-demo (
        name: Stop live jobs demo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Same reason as "Start live jobs demo": no compile-time dependency
                -- on the demo-only package.
                execute immediate 'begin ersh_demo_data_api.stop_live_jobs_demo; end;';
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Live jobs demo stopped. Their run history stays on this dashboard.
        }
        advanced {
            executionMappingIdentifier: 52462354244934054
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'STOP_LIVE_DEMO'
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    branch (
        name: Back to Jobs Dashboard
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1000
            }
        }
    )

)

