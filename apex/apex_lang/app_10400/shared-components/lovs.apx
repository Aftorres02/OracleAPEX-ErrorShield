lov desktop-theme-styles (
    name: DESKTOP THEME STYLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select s.name d,
                   s.theme_style_id r
              from apex_application_theme_styles s,
                   apex_application_themes t
             where s.application_id = :app_id
               and t.application_id = s.application_id
               and t.theme_number   = s.theme_number
               and t.ui_type_name   = 'DESKTOP'
               and t.is_current     = 'Yes'
             order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov logger-level (
    name: LOGGER_LEVEL_VALUES
    source {
        location: staticValues
    }

    entry apex (
        sequence: 90
        display: APEX
        return: APEX
    )

    entry debug (
        sequence: 60
        display: DEBUG
        return: DEBUG
    )

    entry error (
        sequence: 30
        display: ERROR
        return: ERROR
    )

    entry information (
        sequence: 50
        display: INFORMATION
        return: INFORMATION
    )

    entry off (
        sequence: 10
        display: OFF
        return: OFF
    )

    entry permanent (
        sequence: 20
        display: PERMANENT
        return: PERMANENT
    )

    entry sys-context (
        sequence: 80
        display: SYS_CONTEXT
        return: SYS_CONTEXT
    )

    entry timing (
        sequence: 70
        display: TIMING
        return: TIMING
    )

    entry warning (
        sequence: 40
        display: WARNING
        return: WARNING
    )

)

lov login-remember-username (
    name: LOGIN_REMEMBER_USERNAME
    source {
        location: staticValues
    }

    entry remember-username (
        sequence: 10
        display: Remember username
        return: Y
    )

)

lov user-theme-preference (
    name: USER_THEME_PREFERENCE
    source {
        location: staticValues
    }

    entry allow-end-users-to-choose-theme-style (
        sequence: 1
        display: Allow End Users to choose Theme Style
        return: Yes
    )

)

