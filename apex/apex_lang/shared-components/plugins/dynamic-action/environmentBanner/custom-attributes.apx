customAttribute attribute_01 (
    apexlangName: environmentLabel
    attribute: 1
    name: Environment Label
    type: pageItem
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText: DEV Environment or UAT Environment or nothing for PROD
    }
)

customAttribute attribute_02 (
    apexlangName: bannerColor
    attribute: 2
    name: Banner Color
    type: pageItem
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: #377E55
    }
    help {
        helpText: Any HEX color for the environment e.g. #377E55
    }
)

