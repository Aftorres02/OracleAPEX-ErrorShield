    button NEXT_LESSON (
        buttonName: NEXT_LESSON
        label: Lesson 2: Table and Column Errors
        layout {
            sequence: 20
            region: @lessonNavSR
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-chevron-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
