    dynamicAction refresh-click (
        name: Refresh Incidents
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @REFRESH
        }

        action refresh-incidents (
            action: refresh
            affectedElements {
                selectionType: region
                region: @incidentsCR
            }
            execution {
                sequence: 10
            }
        )

    )

    process divide-by-zero (
        name: Division by zero (ORA-01476)
        type: executeCode
        source {
            plsqlCode: elab_errors_api.force_division_by_zero;
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 24865229981638747
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'DIVIDE_BY_ZERO'
        }
    )

