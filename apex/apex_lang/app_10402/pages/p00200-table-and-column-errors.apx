    button CHECK_VIOLATION (
        buttonName: CHECK_VIOLATION
        label: Raise error
        layout {
            sequence: 10
            region: @checkViolationSR
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-bolt
        }
        advanced {
            htmlDomId: CHECK_VIOLATION
        }
    )

    button CHILD_FOUND (
        buttonName: CHILD_FOUND
        label: Raise error
        layout {
            sequence: 10
            region: @childFoundSR
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconLeft
            ]
            icon: fa-bolt
        }
        advanced {
            htmlDomId: CHILD_FOUND
        }
    )

    button NEXT_LESSON (
        buttonName: NEXT_LESSON
        label: Lesson 3: AJAX Errors
        layout {
            sequence: 20
            region: @lessonNavSR
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-chevron-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 300
            }
        }
        advanced {
            htmlDomId: NEXT_LESSON
        }
    )

