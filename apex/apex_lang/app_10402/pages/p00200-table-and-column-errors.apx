page 200 (
    name: Table and Column Errors
    alias: TABLE-AND-COLUMN-ERRORS
    title: Table and Column Errors
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }

    region checkViolationSR (
        name: Quantity of zero
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ersh-lab-badges"><span class="ersh-lab-badge ersh-lab-badge-code">ORA-02290</span><span class="ersh-lab-badge ersh-lab-badge-friendly">Friendly message</span></div>
                <p><code>ck_elab_orders_quantity</code> has a message in <code>ersh_constraint_lookup</code>.</p>
                <p class="ersh-lab-note">ErrorShield shows the registered message. Nothing is recorded.</p>
                ```
        }
        layout {
            sequence: 100
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ersh-lab-card
        }
        advanced {
            htmlDomId: checkViolationSR
        }
    )

    region childFoundSR (
        name: Delete a customer with orders
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ersh-lab-badges"><span class="ersh-lab-badge ersh-lab-badge-code">ORA-02292</span><span class="ersh-lab-badge ersh-lab-badge-incident">Incident</span></div>
                <p>The same unregistered foreign key, hit from the parent side.</p>
                <p class="ersh-lab-note">ErrorShield logs it, records an incident and masks the message.</p>
                ```
        }
        layout {
            sequence: 70
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ersh-lab-card
        }
        advanced {
            htmlDomId: childFoundSR
        }
    )

    region incidentsCR (
        name: Incidents From This Lesson
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.component_name                                             as component_name
                     , i.ora_sqlcode                                                as ora_sqlcode
                     , i.error_summary                                              as error_summary
                     , i.occurrence_count                                           as occurrence_count
                     , to_char(i.created_on, 'DD-MON HH24:MI:SS')                   as first_seen
                  from ersh_shield_incidents_vw i
                 where i.application_id = :APP_ID
                   and i.page_id        = :APP_PAGE_ID
                 order by i.created_on desc
                 fetch first 10 rows only
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            icon: fa-list-alt
        }
        advanced {
            htmlDomId: incidentsCR
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No incidents from this lesson yet. Raise one of the errors above.
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Component
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column ERROR_SUMMARY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Error Summary (admin only)
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column FIRST_SEEN (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: First Seen
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column OCCURRENCE_COUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Hits
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column ORA_SQLCODE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: SQLCODE
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    region introSR (
        name: Lesson 2 · Table and Column Errors
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>The table itself refuses the data: sizes, data types, required columns and constraints. Whether
                the user gets a friendly message depends on one thing: is the constraint registered in
                <code>ersh_constraint_lookup</code>?</p>
                <p class="ersh-lab-note">Watch for: the same kind of error (a constraint) ends up masked and recorded,
                or friendly and unrecorded, only because of that registration.</p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
            icon: fa-table
        }
        advanced {
            htmlDomId: introSR
        }
    )

    region lessonNavSR (
        name: Lesson Navigation
        type: staticContent
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: lessonNavSR
        }
    )

    region notNullSR (
        name: Required column left empty
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ersh-lab-badges"><span class="ersh-lab-badge ersh-lab-badge-code">ORA-01400</span><span class="ersh-lab-badge ersh-lab-badge-incident">Incident</span></div>
                <p>A customer inserted without its mandatory name.</p>
                <p class="ersh-lab-note">ErrorShield logs it, records an incident and masks the message.</p>
                ```
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ersh-lab-card
        }
        advanced {
            htmlDomId: notNullSR
        }
    )

    region numericOverflowSR (
        name: Number too large for the column
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ersh-lab-badges"><span class="ersh-lab-badge ersh-lab-badge-code">ORA-01438</span><span class="ersh-lab-badge ersh-lab-badge-incident">Incident</span></div>
                <p>Quantity 1,000,000 into <code>quantity number(5)</code>.</p>
                <p class="ersh-lab-note">ErrorShield logs it, records an incident and masks the message.</p>
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ersh-lab-card
        }
        advanced {
            htmlDomId: numericOverflowSR
        }
    )

    region parentNotFoundSR (
        name: Order for a missing customer
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ersh-lab-badges"><span class="ersh-lab-badge ersh-lab-badge-code">ORA-02291</span><span class="ersh-lab-badge ersh-lab-badge-incident">Incident</span></div>
                <p>Foreign key <code>fk_elab_orders_customers</code>, deliberately not registered.</p>
                <p class="ersh-lab-note">ErrorShield logs it, records an incident and masks the message.</p>
                ```
        }
        layout {
            sequence: 60
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ersh-lab-card
        }
        advanced {
            htmlDomId: parentNotFoundSR
        }
    )

    region registeredSR (
        name: Registered: Friendly Message
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Registered with <code>ersh_error_handler_api.merge_ersh_constraint_lookup</code> by the lab's seed
                script. The user can fix these, so they are shown, not recorded.</p>
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
        advanced {
            htmlDomId: registeredSR
        }
    )

    region uniqueViolationSR (
        name: Duplicate customer code
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ersh-lab-badges"><span class="ersh-lab-badge ersh-lab-badge-code">ORA-00001</span><span class="ersh-lab-badge ersh-lab-badge-friendly">Friendly message</span></div>
                <p><code>uk_elab_customers_code</code> has a message in <code>ersh_constraint_lookup</code>.</p>
                <p class="ersh-lab-note">ErrorShield shows the registered message. Nothing is recorded.</p>
                ```
        }
        layout {
            sequence: 90
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ersh-lab-card
        }
        advanced {
            htmlDomId: uniqueViolationSR
        }
    )

    region unregisteredSR (
        name: Not Registered: Masked and Recorded
        type: staticContent
        source {
            htmlCode: <p>Nothing tells ErrorShield these are expected, so they take the unexpected-error path.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
        advanced {
            htmlDomId: unregisteredSR
        }
    )

    region valueTooLargeSR (
        name: Text too long for the column
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ersh-lab-badges"><span class="ersh-lab-badge ersh-lab-badge-code">ORA-12899</span><span class="ersh-lab-badge ersh-lab-badge-incident">Incident</span></div>
                <p>A 47-character name into <code>customer_name varchar2(30 char)</code>.</p>
                <p class="ersh-lab-note">ErrorShield logs it, records an incident and masks the message.</p>
                ```
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
