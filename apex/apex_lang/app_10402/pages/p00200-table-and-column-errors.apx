    button REFRESH (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 10
            region: @incidentsCR
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: REFRESH
        }
    )

    button UNIQUE_VIOLATION (
        buttonName: UNIQUE_VIOLATION
        label: Raise error
