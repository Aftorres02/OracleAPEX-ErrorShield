            icon: fa-bolt
        }
        advanced {
            htmlDomId: VALUE_TOO_LARGE
        }
    )

    dynamicAction refresh-click (
        name: Refresh Incidents
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @REFRESH
        }

        action refresh-incidents (
            action: refresh
            affectedElements {
                selectionType: region
                region: @incidentsCR
            }
            execution {
                sequence: 10
            }
        )

    )

    process check-violation (
        name: Quantity of zero (ORA-02290)
        type: executeCode
        source {
            plsqlCode: elab_errors_api.force_check_violation;
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 24869491421638808
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'CHECK_VIOLATION'
        }
    )

    process child-found (
        name: Delete a customer with orders (ORA-02292)
        type: executeCode
        source {
            plsqlCode: elab_errors_api.force_child_found;
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 24869210077638807
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'CHILD_FOUND'
        }
    )

    process not-null (
        name: Required column left empty (ORA-01400)
        type: executeCode
        source {
            plsqlCode: elab_errors_api.force_not_null;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 24869058473638807
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'NOT_NULL'
        }
    )

    process numeric-overflow (
        name: Number too large for the column (ORA-01438)
        type: executeCode
        source {
            plsqlCode: elab_errors_api.force_numeric_overflow;
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 24868973556638807
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'NUMERIC_OVERFLOW'
        }
    )

    process parent-not-found (
        name: Order for a missing customer (ORA-02291)
        type: executeCode
        source {
            plsqlCode: elab_errors_api.force_parent_not_found;
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 24869103377638807
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'PARENT_NOT_FOUND'
        }
    )

    process unique-violation (
        name: Duplicate customer code (ORA-00001)
        type: executeCode
        source {
            plsqlCode: elab_errors_api.force_unique_violation;
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 24869347851638808
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'UNIQUE_VIOLATION'
        }
    )

    process value-too-large (
        name: Text too long for the column (ORA-12899)
        type: executeCode
        source {
            plsqlCode: elab_errors_api.force_value_too_large;
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 24868879162638807
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'VALUE_TOO_LARGE'
        }
    )

)

