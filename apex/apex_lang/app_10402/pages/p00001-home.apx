    dynamicAction ajax-da-click (
        name: AJAX Dynamic Action Error
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @AJAX_DA
        }

        action force-error-server-side (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    elab_errors_api.force_error(
                        p_scenario                       => :P1_AJAX_SCENARIO
                    );
                    ```
                itemsToSubmit: P1_AJAX_SCENARIO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction ajax-handled-click (
        name: AJAX Handled Error
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @AJAX_HANDLED
        }

        action fire-handled (
            action: executeJsCode
            settings {
                jsCode: elab.errorLab.fireHandled(apex.item('P1_AJAX_SCENARIO').getValue());
            }
            execution {
                sequence: 10
            }
        )

    )

