list navigation-bar (
    name: Navigation Bar

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry lesson-1 (
        label: 1 · PL/SQL Runtime
        icon {
            imageIconCssClasses: fa-code
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 100
            }
        }
    )

    entry lesson-2 (
        label: 2 · Table and Column
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 200
            }
        }
    )

    entry lesson-3 (
        label: 3 · AJAX
        icon {
            imageIconCssClasses: fa-exchange
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 300
            }
        }
    )

    entry lesson-4 (
        label: 4 · Rendering and Business
        icon {
            imageIconCssClasses: fa-bug
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 400
            }
        }
    )

    entry overview (
        label: Overview
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

)

